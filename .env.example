# ==============================================================================
# SAAS MODE (DEFAULT) - One platform serving multiple realtor clients
# ==============================================================================

# Database (REQUIRED for SaaS mode)
DATABASE_URL="postgresql://user:password@localhost:5432/real_estate_champ"

# Stripe (REQUIRED for payments and subscriptions)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Stripe Price IDs (create these in your Stripe dashboard)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID="price_starter_monthly"
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_pro_monthly"
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID="price_enterprise_monthly"

# WordPress Connection (OPTIONAL - for realtors who want to connect their own WordPress)
NEXT_PUBLIC_WORDPRESS_URL=""

# NextAuth.js (Optional - only needed for standalone mode, WordPress handles auth in PWA mode)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Google AI (Configured in WordPress plugin settings, these are fallbacks for standalone mode)
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Social Media OAuth (Admin manages these, users authorize)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

INSTAGRAM_APP_ID="your-instagram-app-id"  # Usually same as Facebook
INSTAGRAM_APP_SECRET="your-instagram-app-secret"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

GOOGLE_BUSINESS_CLIENT_ID="your-google-business-client-id"
GOOGLE_BUSINESS_CLIENT_SECRET="your-google-business-client-secret"

# File Upload
MAX_FILE_SIZE="10485760"  # 10MB in bytes
UPLOAD_DIR="./uploads"

# Property Data Storage
PROPERTY_DATA_DIR="./data/properties"
